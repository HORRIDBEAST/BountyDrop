# Copy to `.env` and fill in (never commit `.env`)
# Private key of the wallet that deploys QuestEscrow + SpendVault and owns
# the 2% protocol fee / vault ownership.
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HEX_WITHOUT_0X

# Address authorized to resolve Track B photo-proof quests — the server
# identity behind app/api/verify-photo/route.ts. Can be the same address as
# the deployer for a first pass; rotate to a dedicated hot wallet before
# handling real value.
PHOTO_ORACLE_ADDRESS=0xYOUR_ORACLE_ADDRESS

# Filled in after `forge script script/Deploy.s.sol --broadcast` deploys:
# QUEST_ESCROW_ADDRESS=0x...
# SPEND_VAULT_ADDRESS=0x...
