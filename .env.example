# Copy to .env.local (app) and never commit the real file.

# Server-side only — used by app/api/verify-photo/route.ts to call the AI
# vision judge (OpenAI gpt-4o) for Track B (photo-proof) quests. Never
# expose this to the client; the verification call must stay server-side.
OPENAI_API_KEY=sk-...

# Server-side only — private key of the photoOracle wallet set on
# QuestEscrow at deploy time (see contracts/.env's PHOTO_ORACLE_ADDRESS).
# Used by app/api/verify-photo/route.ts to submit resolvePhotoTask() after
# the AI vision judge returns a verdict. Never expose this to the client.
# Rotate to a dedicated hot wallet holding only enough MON for gas — this
# key should never also be a funds-custody key.
PHOTO_ORACLE_PRIVATE_KEY=0xYOUR_ORACLE_PRIVATE_KEY_HEX_WITHOUT_0X

# Public contract addresses, filled in after `forge script script/Deploy.s.sol`
# actually deploys to Monad Testnet (see contracts/.env for the deployer key).
NEXT_PUBLIC_QUEST_ESCROW_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_SPEND_VAULT_ADDRESS=0x0000000000000000000000000000000000000000

# Owner/oracle wallet that the frontend never signs with directly, but whose
# address is referenced in copy ("resolved by BountyDrop's verifier").
NEXT_PUBLIC_PHOTO_ORACLE_ADDRESS=0x0000000000000000000000000000000000000000
